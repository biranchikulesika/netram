{
  "name": "@netram/inspector-mobile",
  "version": "0.1.0",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#ffffff"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:port": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^15.1.1",
    "@netram/api-client": "workspace:*",
    "@netram/config": "workspace:*",
    "@netram/types": "workspace:*",
    "@react-navigation/native": "^7.4.1",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-modules-core": "~2.2.3",
    "expo-router": "~4.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-helmet-async": "2.0.4",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-refresh": "^0.14.2",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.3"
  }

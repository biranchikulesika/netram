# Netram environment documentation.
# All values here are PLACEHOLDERS. Do not commit real values.
# Copy to `.env` for local development (see docs/development/setup.md).
#
# Note: Node/Next only read NEXT_PUBLIC_* values into client bundles.
# All other values are server-side only and must never be prefixed NEXT_PUBLIC_.

# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
DATABASE_URL=postgres://netram:netram@localhost:5432/netram

# ---- Redis / queues ----
REDIS_URL=redis://localhost:6379

# ---- API ----
NETRAM_API_HOST=0.0.0.0
NETRAM_API_PORT=3001
NETRAM_CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ---- Web ----
# Public URL of the API, reachable FROM THE BROWSER. The web app is a
# same-origin BFF, so the browser normally never uses this directly (it calls
# the BFF, which attaches the session token). Kept as the documented
# browser-facing base for clients that do talk to the API directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix on purpose: never sent to the
# browser). Base URL the web app's own server code uses when it calls the API —
# the /api/v1 BFF proxy and the CCTV/evidence route handlers. Point this at the
# internal service address in any deployment, never at the public origin:
# a server-side hop to the public origin would leave the host, re-resolve public
# DNS and traverse the edge proxy, making the app depend on its own public DNS
# and certificate before any API call can work.
NETRAM_API_BASE_URL=http://localhost:3001

# Public WebSocket URL of the realtime service for browsers.
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:3002

# ---- CCTV media rig (dev only; server-side within the web app) ----
# MediaMTX WHEP HTTP endpoint targeted by the same-origin web proxy route
# /api/dev/cctv/whep. Requires `docker compose --profile media up`.
NETRAM_MEDIAMTX_WHEP_URL=http://localhost:8189

# ---- Inspector mobile (client-exposed) ----
# Expo inlines EXPO_PUBLIC_* values into the RN bundle at build time.
# Public URL of the API reachable from the device/emulator.
EXPO_PUBLIC_API_URL=http://localhost:3001

# ---- Authentication ----
# dev = local development only. supabase = Supabase Auth (validation of JWTs).
NETRAM_AUTH_PROVIDER=dev
# 32+ char HMAC secret for signing dev-only JWTs. NEVER use in production. NEVER commit.
NETRAM_DEV_AUTH_SECRET=replace-me-with-a-32-char-plus-dev-only-secret-for-local-development
# Supabase Auth (only needed when NETRAM_AUTH_PROVIDER=supabase)
NETRAM_SUPABASE_URL=
NETRAM_SUPABASE_JWT_SECRET=

# ---- Realtime ----
NETRAM_REALTIME_URL=http://localhost:3002
# Internal base URL of the API, used by the realtime service to reach the API.
NETRAM_API_URL=http://localhost:3001
NETRAM_REALTIME_PORT=3002
NETRAM_REALTIME_POLL_MS=1000
NETRAM_REALTIME_OUTBOX_BATCH=50

# ---- Object storage (S3 / MinIO) ----
NETRAM_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
NETRAM_OBJECT_STORAGE_ACCESS_KEY=netram
NETRAM_OBJECT_STORAGE_SECRET_KEY=netram-secret
NETRAM_OBJECT_STORAGE_BUCKET=netram
NETRAM_OBJECT_STORAGE_USE_SSL=false

# ---- CCTV Gateway (control-plane media bridge, Phase 3) ----
NETRAM_CCTV_GATEWAY_HOST=0.0.0.0
NETRAM_CCTV_GATEWAY_PORT=3003
NETRAM_CCTV_GATEWAY_URL=http://localhost:3003
NETRAM_CCTV_STREAM_SECRET=replace-me-with-a-32-char-plus-cctv-stream-secret
# Shared secret the NETRAM API presents to the gateway (service-to-service).
NETRAM_CCTV_SERVICE_SECRET=replace-me-with-a-32-char-plus-cctv-service-secret
# Internal MediaMTX control API (gateway -> MediaMTX, server-side only).
NETRAM_MEDIAMTX_API_URL=http://localhost:9997
NETRAM_MEDIAMTX_API_USERNAME=admin
NETRAM_MEDIAMTX_API_PASSWORD=netram-dev-internal
# Browser-facing WHEP base minted into playback contracts (NOT the internal
# API address; may differ per deployment).
NETRAM_MEDIAMTX_WHEP_PUBLIC_URL=http://localhost:8189
# Dev-only ingest override: provision MediaMTX paths from this RTSP source
# instead of DB camera endpoints (dev rig convenience; empty in production).
NETRAM_MEDIAMTX_DEV_INGEST_SOURCE=
# Secret the MediaMTX external auth hook must present to the NETRAM API
# (Phase 4 media-plane authorization). Server-only; must be 32+ chars.
NETRAM_MEDIAMTX_HOOK_SECRET=replace-me-with-a-32-char-plus-mediamtx-hook-secret

# ---- Workers ----
#NETRAM_SMTP_URL=smtp://localhost:1025
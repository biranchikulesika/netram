# Netram environment documentation.
# All values here are PLACEHOLDERS. Do not commit real values.
# Copy to `.env` for local development (see docs/development/setup.md).
#
# Note: Node/Next only read NEXT_PUBLIC_* values into client bundles.
# All other values are server-side only and must never be prefixed NEXT_PUBLIC_.

# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
DATABASE_URL=postgres://netram:netram@localhost:5432/netram

# ---- Redis / queues ----
REDIS_URL=redis://localhost:6379

# ---- API ----
NETRAM_API_HOST=0.0.0.0
NETRAM_API_PORT=3001
NETRAM_CORS_ORIGIN=http://localhost:3000

# ---- Web (client-exposed) ----
# Public URL of the API reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public WebSocket URL of the realtime service for browsers.
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:3002

# ---- Inspector mobile (client-exposed) ----
# Expo inlines EXPO_PUBLIC_* values into the RN bundle at build time.
# Public URL of the API reachable from the device/emulator.
EXPO_PUBLIC_API_URL=http://localhost:3001

# ---- Authentication ----
# dev = local development only. supabase = Supabase Auth (validation of JWTs).
NETRAM_AUTH_PROVIDER=dev
# 32+ char HMAC secret for signing dev-only JWTs. NEVER use in production. NEVER commit.
NETRAM_DEV_AUTH_SECRET=replace-me-with-a-32-char-plus-dev-only-secret-for-local-development
# Supabase Auth (only needed when NETRAM_AUTH_PROVIDER=supabase)
NETRAM_SUPABASE_URL=
NETRAM_SUPABASE_JWT_SECRET=

# ---- Realtime ----
NETRAM_REALTIME_URL=http://localhost:3002
# Internal base URL of the API, used by the realtime service to reach the API.
NETRAM_API_URL=http://localhost:3001
NETRAM_REALTIME_PORT=3002
NETRAM_REALTIME_POLL_MS=1000
NETRAM_REALTIME_OUTBOX_BATCH=50

# ---- Object storage (S3 / MinIO) ----
NETRAM_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
NETRAM_OBJECT_STORAGE_ACCESS_KEY=netram
NETRAM_OBJECT_STORAGE_SECRET_KEY=netram-secret
NETRAM_OBJECT_STORAGE_BUCKET=netram
NETRAM_OBJECT_STORAGE_USE_SSL=false

# ---- CCTV Gateway ----
NETRAM_CCTV_GATEWAY_HOST=0.0.0.0
NETRAM_CCTV_GATEWAY_PORT=3003
NETRAM_CCTV_GATEWAY_URL=http://localhost:3003
NETRAM_CCTV_STREAM_SECRET=replace-me-with-a-32-char-plus-cctv-stream-secret

# ---- Workers ----
#NETRAM_SMTP_URL=smtp://localhost:1025
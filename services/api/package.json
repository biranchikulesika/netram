{
  "name": "@netram/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/notification.worker.ts",
    "workers": "tsx src/workers/run-workers.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --testNamePattern 'unit'",
    "test:integration": "vitest run --testNamePattern 'integration'",
    "export:openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@netram/config": "workspace:*",
    "@netram/data": "workspace:*",
    "@netram/types": "workspace:*",
    "@netram/validation": "workspace:*",
    "bullmq": "^5.34.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jose": "^6.0.8",
    "minio": "^8.0.7",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}

# Netram - single-VPS deployment environment (netram.kulesika.in).
#
# Copy to `.env.vps` and fill in real values, then deploy with:
#     podman-compose --file docker-compose.yml --env-file .env.vps up -d --build
#
# `.env.vps` is gitignored (see the `.env.*` rule in .gitignore). Never commit
# it. Every value below marked CHANGE ME must be replaced with a real secret:
#
#     openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-52
#
# Note: this is the COMPOSE substitution file, not the service runtime env.
# Each service's actual environment is declared in the `environment:` block of
# the service in docker-compose.yml. Values here only parameterise those blocks.

# ---------------------------------------------------------------- public origin
# Public hostname. Must resolve (A record) to this host's IP.
NETRAM_DOMAIN=netram.kulesika.in
# Browser-facing origin of the site. Used as the public API base by the web BFF.
NETRAM_SITE_ORIGIN=https://netram.kulesika.in
# Allowed browser origin for API CORS. The browser normally reaches the API
# same-origin through the web BFF, so this is a defence-in-depth value.
NETRAM_CORS_ORIGIN=https://netram.kulesika.in

# ---------------------------------------------------------------- host ports
# Loopback ports the host nginx proxies to. Must not collide with other tenants.
NETRAM_WEB_PUBLISHED_PORT=3100
NETRAM_REALTIME_PUBLISHED_PORT=3202
# Public UDP/TCP port for the WebRTC media plane (must be open in any firewall).
NETRAM_MEDIA_PUBLISHED_PORT=8189

# ---------------------------------------------------------------- demo database
# Demo reset cadence in seconds. 1800 = every 30 minutes: the schema is dropped,
# rebuilt from migrations and re-seeded, so every visitor starts from the same
# state and trial edits disappear. Set higher (e.g. 21600 = 6h) to reduce
# interruptions for people mid-task.
NETRAM_DEMO_RESET_SECONDS=1800

# ---------------------------------------------------------------- datastores
POSTGRES_USER=netram
# CHANGE ME
POSTGRES_PASSWORD=replace-me-with-a-strong-postgres-password
POSTGRES_DB=netram

# ---------------------------------------------------------------- object storage
NETRAM_OBJECT_STORAGE_ACCESS_KEY=netram
# CHANGE ME (MinIO requires >= 8 characters)
NETRAM_OBJECT_STORAGE_SECRET_KEY=replace-me-with-a-strong-object-storage-secret
NETRAM_OBJECT_STORAGE_BUCKET=netram

# ---------------------------------------------------------------- internal service secrets
# These MUST match across the services that share them:
#   NETRAM_CCTV_STREAM_SECRET   - api/workers <-> cctv-gateway (relay tokens)
#   NETRAM_CCTV_SERVICE_SECRET  - api/workers <-> cctv-gateway (control plane)
#   NETRAM_MEDIAMTX_HOOK_SECRET - api <- mediamtx external auth hook
#   NETRAM_DEV_AUTH_SECRET      - api/workers/realtime (dev auth provider JWTs)
#
# DEMO AUTH: NETRAM_AUTH_PROVIDER=dev signs visitors in as a seeded demo account
# with no password check. This is a deliberate demo choice, NOT a production
# authentication model. See docs/deployment.md.
#
# CHANGE ME (each must be >= 32 characters)
NETRAM_DEV_AUTH_SECRET=replace-me-with-a-32-char-plus-dev-only-secret-for-local-development
NETRAM_CCTV_STREAM_SECRET=replace-me-with-a-32-char-plus-cctv-stream-secret
NETRAM_CCTV_SERVICE_SECRET=replace-me-with-a-32-char-plus-cctv-service-secret
NETRAM_MEDIAMTX_HOOK_SECRET=replace-me-with-a-32-char-plus-mediamtx-hook-secret

# ---------------------------------------------------------------- media plane
# MediaMTX control API credentials. Internal admin user from
# infra/mediamtx/mediamtx.yml; the gateway and the web proxy present these
# server-side. CHANGE ME if you change authInternalUsers in that file.
NETRAM_MEDIAMTX_API_USERNAME=admin
NETRAM_MEDIAMTX_API_PASSWORD=replace-me-to-match-infra-mediamtx-yml-authinternalusers

# Camera rig mode: "pull" (NETRAM media server pulls the facility NVR on
# demand - the pilot topology) or "push" (facility pushes into NETRAM).
NETRAM_CCTV_SIM_MODE=pull

# ---------------------------------------------------------------- logging
LOG_LEVEL=info

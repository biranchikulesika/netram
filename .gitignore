# ================= Dependencies =================
node_modules/
.pnpm-store/

# ================= Build output =================
dist/
build/
out/
*.tsbuildinfo

# ================= Framework caches =================
.next/
.turbo/
cache/
.eslintcache
.coverage/

# ================= Environment & secrets =================
# Local and environment-specific `.env` files always carry secrets.
.env
.env.local
.env.*
!.env.example
!.env.sample
# Deployment templates carry placeholders only; the real .env.vps stays ignored.
!.env.vps.example

# ================= Private keys & certificates =================
*.pem
*.key
*.p12
*.pfx
*.p8
*.pk8

# ================= Database & local data =================
# Guards local SQLite artifacts (the mobile offline store is device-local;
# these prevent accidental local copies). Migrations/schema are .sql/.ts, untouched.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
supabase/.temp/
supabase/.branches/

# ================= Logs & runtime output =================
*.log
logs/
tmp/
temp/

# ================= Python =================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# ================= Mobile (Expo / React Native) =================
apps/inspector-mobile/.expo/
apps/inspector-mobile/dist/
apps/inspector-mobile/web-build/
apps/inspector-mobile/android/
apps/inspector-mobile/ios/

# ================= IDE & OS =================
.DS_Store
Thumbs.db
.idea/
.vscode/
.kilo/
.freebuff/
*.swp
*.swo

# ================= Infrastructure state =================
# Local developer-machine data only; never shared configuration.
infrastructure/.data/

# ================= Test artifacts =================
coverage/

# ================= Markdown =================
# Ignore editor backup/scratch markdown files
*~.md
*.tmp.md
*.scratch.md

# Default: unapproved markdown files outside docs are ignored
*.md

# Root repository documentation
!README.md
!AGENTS.md
!DESIGN.md
!SECURITY.md

# Canonical documentation suite
!docs/*.md
!docs/**/*.md

